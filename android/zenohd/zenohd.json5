{
  mode: "router",
  listen: {
    endpoints: ["unixsock-stream//dev/socket/zenohd.sock"],
  },
  connect: {
    endpoints: [],
  },
  scouting: {
    multicast: { enabled: false },
    gossip: { enabled: false },
  },
  timestamping: {
    enabled: { router: true },
  },
  plugins: {
    storage_manager: {
      storages: {
        config: {
          key_expr: "config/*",
          volume: { id: "memory" },
        },
      },
    },
  },
}
